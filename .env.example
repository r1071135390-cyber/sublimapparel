# Stripe Configuration
# Get keys from https://dashboard.stripe.com → Developers → API keys
# (Use Live mode for production, Test mode for development)

# Server-side secret key (NEVER expose to frontend, set as encrypted env var in Cloudflare Pages)
# Example format: your_stripe_secret_key_here
STRIPE_SECRET_KEY=

# Webhook signing secret (set after creating webhook endpoint in Stripe Dashboard)
# Example format: your_webhook_signing_secret_here
STRIPE_WEBHOOK_SECRET=

# Public key (safe to embed in frontend code, also set as env var for build-time injection)
# Example format: your_stripe_publishable_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
