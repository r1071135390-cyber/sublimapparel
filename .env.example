# Stripe Configuration
# Get keys from https://dashboard.stripe.com → Developers → API keys
# (Use Live mode for production, Test mode for development)

# Server-side secret key (NEVER expose to frontend, set as encrypted env var in Cloudflare Pages)
# Example format: your_stripe_secret_key_here
STRIPE_SECRET_KEY=

# Webhook signing secret (set after creating webhook endpoint in Stripe Dashboard)
# Example format: your_webhook_signing_secret_here
STRIPE_WEBHOOK_SECRET=

# Public key (safe to embed in frontend code, also set as env var for build-time injection)
# Example format: your_stripe_publishable_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Admin API Authentication
# Since R125 every admin-only endpoint (/api/admin/*, /api/pi/{create,list,delete,
# update,next-number}) requires this token. The check FAILS CLOSED: if the
# variable is not set, those endpoints return 403 instead of serving data.
#
# Set it in Cloudflare Pages -> Settings -> Environment variables and tick BOTH
# Production and Preview. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# The admin UI (/administered/*) asks for this token once and keeps it in
# sessionStorage for that browser tab only.
ADMIN_TOKEN=

# Owner password for /administered/* (R128)
# The password itself is NOT stored in the public JavaScript bundle — the
# admin gate posts it to /api/admin/verify and the server checks it against
# this variable.
#
# Set it in Cloudflare Pages -> Settings -> Environment variables and tick BOTH
# Production and Preview. If it is missing, the admin gate refuses to unlock.
#
# You may paste EITHER the password itself:
#   OWNER_PASSWORD_HASH=your-password
# ...or its SHA-256 hex digest:
#   node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "your-password"
#
# A 64-character hex value is read as a digest; anything else is read as the
# password itself. Both work.
OWNER_PASSWORD_HASH=

# Multi-user roster (R132)
# One entry per person who may use /administered/*. Each entry carries its OWN
# admin token, its OWN password and a role, so one person's credential cannot
# be used by somebody else and one person's password cannot be revoked without
# touching everybody else's.
#
# Generate an entry with:
#   node scripts/gen-admin-users.mjs --email sales@sublimapparel.com --role admin
# It prints the JSON line to paste here plus the plaintext password to hand
# over to the new colleague.
#
# Format — a JSON array (one object per account):
#   ADMIN_USERS=[{"id":"you@x.com","email":"you@x.com","role":"owner","token":"…","passwordHash":"…"}]
# …or one JSON object per line:
#   ADMIN_USERS={"id":"you@x.com",…}
#           {"id":"other@x.com",…}
#
# Fields per account:
#   id           — unique label for the account (the e-mail is used by default)
#   email        — shown in the admin header
#   role         — "owner" or "admin"
#   token        — that account's admin token (Authorization: Bearer <token>)
#   passwordHash — SHA-256 hex of that account's password (or the password itself)
#
# Roles:
#   owner — everything, plus editing the corporate bank accounts and deleting
#           invoices.
#   admin — create / edit / upload invoices, read the PI summary and the
#           customer archive. Bank-account writes and invoice deletes are
#           refused by the server.
#
# The roster is OPTIONAL. Leave it unset and the single ADMIN_TOKEN above keeps
# working exactly as before (it is then treated as an owner account), so an
# existing deployment is never locked out by the rollout.
ADMIN_USERS=
