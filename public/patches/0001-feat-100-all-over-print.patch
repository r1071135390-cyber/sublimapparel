+                  onClick={() => toggle("categories", cat)}
+                >
+                  {cat}
+                </FilterChip>
+              ))}
+            </div>
+          </div>
+
+          {/* SPORT */}
+          <div className="mb-4 md:mb-6">
+            <h3 className="mb-2 text-[10px] font-bold uppercase tracking-widest text-[#6b6b6b] md:text-xs">
