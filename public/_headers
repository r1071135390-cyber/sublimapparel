# sublimapparel.com - Cloudflare Pages edge rules
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Edge cache: 5 min fresh, 1 day stale-while-revalidate (deploys are fast, OK to revalidate)
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=300, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # HSTS: 1 year, include subdomains, preload-ready
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # Remove server fingerprint
  X-Powered-By: ""

# Hashed Next.js assets — long cache, immutable
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# User-uploaded media — week browser, month edge
/*.webp
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000
/*.jpg
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000
/*.jpeg
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000
/*.png
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000
/*.gif
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000
/*.svg
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000
/*.avif
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000
/*.mp4
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000
/*.webm
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000

# ===========================================================================
# Sitemap & robots — no-store so any push to GitHub main is picked up
# immediately by every edge. The robots.txt rule must be no-store because
# Cloudflare Pages' build-time auto-robots feature can still augment our
# file with `Sitemap: /llms.txt` + Yandex `Host:` lines if it finds an
# llms*.txt file in the build output — we removed the trigger files in
# R64 follow-up so this should be clean, but no-store makes sure any
# cached augmented copy from a prior build is invalidated within seconds
# of the next deploy.
# ===========================================================================
/sitemap.xml
  Cache-Control: no-store, max-age=0, must-revalidate
  Content-Type: application/xml; charset=utf-8
/robots.txt
  Cache-Control: no-store, max-age=0, must-revalidate
  Content-Type: text/plain; charset=utf-8

# ===========================================================================
# Blog RSS feed — pre-rendered to out/blog/feed.xml/index.xml at build
# time by scripts/build-rss.mjs. Cloudflare Pages does NOT recognize
# `index.xml` as a directory index file, so we 200-internal-rewrite both
# /blog/feed.xml and /blog/feed.xml/ to /blog/feed.xml/index.xml via
# _redirects. The headers below override the Content-Type on ALL three
# paths (the canonical no-slash URL via the exact rule, the with-slash
# URL via the wildcard `/blog/feed.xml/*` rule) so RSS aggregators see
# `application/rss+xml` — without this, Feedly / Inoreader reject the
# feed as malformed. Cache-Control gives the feed a 1 h edge window with
# 24 h stale-while-revalidate so the feed re-validates on every
# Cloudflare deploy.
# ===========================================================================
/blog/feed.xml/*
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400
/blog/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

# Markdown alternates — point AI crawlers at plain-text versions of every page
# (R64 follow-up: removed the `Link: </llms.txt>; rel="describedby"`
#  header on every page rule — we no longer serve /llms.txt because
#  Cloudflare's auto-robots would auto-inject `Sitemap: /llms.txt` into
#  robots.txt. Per-page markdown alternates are the primary LLM
#  discovery path now. If you re-enable /llms.txt in the future, also
#  turn off the Cloudflare Pages "Auto-generate llms.txt" feature in
#  the dashboard, otherwise the Sitemap injection returns.)
/*.html.md
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=3600
  Content-Type: text/markdown; charset=utf-8

# HTTP Link header — discover markdown alternates for every HTML page
/
  Link: </home.html.md>; rel="alternate"; type="text/markdown"
/products
  Link: </products.html.md>; rel="alternate"; type="text/markdown"
/products/*
  Link: </products.html.md>; rel="alternate"; type="text/markdown"
/fabric
