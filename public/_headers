/fabric/*
  Link: </fabric.html.md>; rel="alternate"; type="text/markdown"
/technique
  Link: </technique.html.md>; rel="alternate"; type="text/markdown"
/technique/*
  Link: </technique.html.md>; rel="alternate"; type="text/markdown"
/shipping
