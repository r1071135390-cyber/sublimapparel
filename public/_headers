# sublimapparel.com - Cloudflare Pages edge rules
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Edge cache: 5 min fresh, 1 day stale-while-revalidate (deploys are fast, OK to revalidate)
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=300, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # HSTS: 1 year, include subdomains, preload-ready
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # Remove server fingerprint
  X-Powered-By: ""

# Hashed Next.js assets — long cache, immutable
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# User-uploaded media — week browser, month edge
/*.webp
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000
/*.jpg
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000
/*.jpeg
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000
/*.png
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000
/*.gif
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000
/*.svg
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000
/*.avif
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000
/*.mp4
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000
/*.webm
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=31536000

# ===========================================================================
# Sitemap & robots — no-store so any push to GitHub main is picked up
# immediately by every edge, even when the Cloudflare "auto-managed
# robots.txt" feature is in play. The previous 1-hour s-maxage
# staled the edge long after we pushed the drop-Sitemap fix in R64.
# ===========================================================================
/sitemap.xml
  Cache-Control: no-store, max-age=0, must-revalidate
  Content-Type: application/xml; charset=utf-8
/robots.txt
  Cache-Control: no-store, max-age=0, must-revalidate
  Content-Type: text/plain; charset=utf-8

# ===========================================================================
# Blog RSS feed — force-static API route at src/app/blog/feed.xml/route.ts.
# With `trailingSlash: true`, Next.js writes the pre-rendered response to
# out/blog/feed.xml/index.html, so Cloudflare Pages serves the file at
# /blog/feed.xml/ with text/html by default. The /blog/feed.xml (no slash)
# URL is preserved via a 301 redirect in _redirects. The headers below
# override the Content-Type so RSS aggregators see the file as
# application/rss+xml — without this, Feedly / Inoreader reject the feed
# as malformed. Cache-Control mirrors the in-route Cache-Control header
# (1 h edge, 24 h stale-while-revalidate) so the feed re-validates on
# every Cloudflare deploy.
# ===========================================================================
/blog/feed.xml/*
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400
/blog/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

# Markdown alternates — point AI crawlers at plain-text versions of every page
/*.html.md
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=3600
  Content-Type: text/markdown; charset=utf-8

# LLM-friendly files — explicit content types. NOTE: the actual files
# live under /llms/ (public/llms/llms.txt, public/llms/llms-full.txt)
# to keep the Cloudflare auto-managed robots.txt feature from
# auto-injecting Sitemap: /llms.txt. The public /llms.txt and
# /llms-full.txt URLs are preserved by /public/_redirects 200
# rewrites so AI crawlers see the same content at the same URLs.
/llms.txt
  Cache-Control: no-store, max-age=0, must-revalidate
  Content-Type: text/markdown; charset=utf-8
/llms-full.txt
  Cache-Control: no-store, max-age=0, must-revalidate
  Content-Type: text/markdown; charset=utf-8

# HTTP Link header — discover markdown alternates for every HTML page
/
  Link: </llms.txt>; rel="describedby"
  Link: </home.html.md>; rel="alternate"; type="text/markdown"
/products
  Link: </llms.txt>; rel="describedby"
  Link: </products.html.md>; rel="alternate"; type="text/markdown"
/products/*
  Link: </llms.txt>; rel="describedby"
/fabric
  Link: </llms.txt>; rel="describedby"
  Link: </fabric.html.md>; rel="alternate"; type="text/markdown"
/fabric/*
  Link: </llms.txt>; rel="describedby"
/technique
  Link: </llms.txt>; rel="describedby"
  Link: </technique.html.md>; rel="alternate"; type="text/markdown"
/technique/*
  Link: </llms.txt>; rel="describedby"
/shipping
  Link: </llms.txt>; rel="describedby"
  Link: </shipping.html.md>; rel="alternate"; type="text/markdown"
/shipping/*
  Link: </llms.txt>; rel="describedby"
/about
  Link: </llms.txt>; rel="describedby"
  Link: </about.html.md>; rel="alternate"; type="text/markdown"
/contact
  Link: </llms.txt>; rel="describedby"
  Link: </contact.html.md>; rel="alternate"; type="text/markdown"
/get-a-quote
  Link: </llms.txt>; rel="describedby"
